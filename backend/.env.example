# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB is required in production; local public provider APIs can run without it.
MONGODB_URI=

# SMTP for account verification and password reset. Keep credentials server-side.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional generated science-guide answers. Keep this key server-side; never add it to client/.env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional NASA key raises the NeoWs API quota above the shared DEMO_KEY limit.
NASA_API_KEY=

# Web Push. Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# Set both key values and a real support email before enabling production alerts.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@terra.local

# Public provider configuration
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Backend controls
CACHE_TTL_SECONDS=300
RATE_LIMIT_MAX=250
PROVIDER_TIMEOUT_MS=12000
TRUST_PROXY_HOPS=0
ALERT_CHECK_INTERVAL_MS=300000
